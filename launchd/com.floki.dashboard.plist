<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.floki.dashboard</string>

  <key>WorkingDirectory</key>
  <string>__PROJECT_PATH__</string>

  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON__</string>
    <string>scripts/run_dashboard.py</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONPATH</key>
    <string>__PROJECT_PATH__/src</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>__PROJECT_PATH__/logs/dashboard.out.log</string>
  <key>StandardErrorPath</key>
  <string>__PROJECT_PATH__/logs/dashboard.err.log</string>
</dict>
</plist>
