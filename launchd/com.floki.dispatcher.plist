<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Single-consumer dispatcher. Must run as exactly ONE instance —
  collision prevention depends on it. launchd KeepAlive keeps it alive;
  do not duplicate this plist.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.floki.dispatcher</string>

  <key>WorkingDirectory</key>
  <string>__PROJECT_PATH__</string>

  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON__</string>
    <string>scripts/run_dispatcher.py</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONPATH</key>
    <string>__PROJECT_PATH__/src</string>
    <key>FLOKI_ADAPTER</key>
    <string>tmux</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>__PROJECT_PATH__/logs/dispatcher.out.log</string>
  <key>StandardErrorPath</key>
  <string>__PROJECT_PATH__/logs/dispatcher.err.log</string>
</dict>
</plist>
